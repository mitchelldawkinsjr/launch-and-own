{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "launch-and-own-mcp-bridge",
  "main": "bridge-worker.mjs",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BRIDGE_DEPLOYMENT": "not_approved",
    "ONBOARDING_ORIGIN": "https://onboard.360web.cloud"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "launch-and-own-mcp-bridge",
      "database_id": "REPLACE_WITH_BRIDGE_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
