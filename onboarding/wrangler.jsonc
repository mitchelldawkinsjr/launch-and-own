{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "launch-and-own-onboarding-beta",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "ONBOARDING_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "launch-and-own-onboarding-beta",
      "database_id": "REPLACE_WITH_INDEPENDENT_D1_UUID",
      "migrations_dir": "migrations"
    }
  ]
}
