{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "launch-and-own-onboarding-beta",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "onboard.360web.cloud",
      "custom_domain": true
    }
  ],
  "vars": {
    "ONBOARDING_ORIGIN": "https://onboard.360web.cloud",
    "CF_SCOPES": "account-settings.read page.read page.write offline_access",
    "GH_CLIENT_ID": "Iv23li8rVTNtZrfTctqJ",
    "GH_APP_SLUG": "launch-and-own",
    "CF_CLIENT_ID": "27de4e083c08b48f9a003ade56b9c8ea"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "ONBOARDING_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "launch-and-own-onboarding-beta",
      "database_id": "b89fb8aa-67a2-49fa-b48c-584e305b5bb2",
      "migrations_dir": "migrations"
    }
  ]
}
