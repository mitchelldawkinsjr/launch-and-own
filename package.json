{
  "name": "launch-and-own",
  "version": "0.1.0-beta",
  "private": true,
  "type": "module",
  "description": "Two-entry customer-owned website platform: ChatGPT conversations and standalone ZIP/web onboarding (beta)",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test pipeline/*.test.mjs onboarding/*.test.mjs site/*.test.mjs scripts/*.test.mjs skills/**/*.test.mjs clients/**/*.test.mjs integration/*.test.mjs imported/*.test.mjs",
    "preflight:onboarding": "node onboarding/validate-config.mjs",
    "demo:export": "node scripts/export-preview.mjs --input examples/willow-studio.json --out ./site-preview",
    "demo:serve": "node scripts/serve-preview.mjs --dir ./site-preview --port 4173",
    "sync:claude-plugin": "node scripts/sync-claude-plugin.mjs",
    "qa:rehearse": "node scripts/beta-rehearsal.mjs",
    "qa:rehearse:recovery": "node scripts/worker-recovery/rehearse.mjs",
    "qa:distribution": "node distribution/release-gates.mjs",
    "visual:walkthrough": "node scripts/visual-walkthrough.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
